{
  "context_servers": {
    "deepsearch-research-agent": {
      "command": {
        "path": "uvx",
        "args": [
          "deepsearch-research-agent",
          "mcp"
        ],
        "env": {
          "SERPER_API_KEY": "your_serper_api_key_here",
          "TAVILY_API_KEY": "your_tavily_api_key_here",
          "DEEPSEARCH_DEFAULT_DEPTH": "deep"
        }
      }
    }
  }
}
