{
  "mcpServers": {
    "deepsearch-research-agent": {
      "command": "uvx",
      "args": [
        "deepsearch-research-agent",
        "mcp"
      ],
      "env": {
        "SERPER_API_KEY": "your_serper_api_key_here",
        "TAVILY_API_KEY": "your_tavily_api_key_here",
        "OPENAI_API_KEY": "your_openai_api_key_here",
        "DEEPSEARCH_DEFAULT_DEPTH": "deep",
        "DEEPSEARCH_ENABLE_CACHE": "true"
      }
    }
  }
}
