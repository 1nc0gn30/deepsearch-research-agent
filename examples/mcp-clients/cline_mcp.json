{
  "mcpServers": {
    "deepsearch-research-agent": {
      "command": "uvx",
      "args": [
        "deepsearch-research-agent",
        "mcp"
      ],
      "env": {
        "SERPER_API_KEY": "your_serper_api_key_here",
        "TAVILY_API_KEY": "your_tavily_api_key_here",
        "DEEPSEARCH_DEFAULT_DEPTH": "deep",
        "DEEPSEARCH_MAX_CONCURRENCY": "6"
      },
      "disabled": false,
      "autoApprove": [
        "plan_queries",
        "verify_claims",
        "extract_consensus"
      ]
    }
  }
}
